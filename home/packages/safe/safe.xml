<?xml version="1.0" encoding="UTF-8"?>
<!-- A safe's Access file, recognised by the line safe create starts it with -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-safe">
    <comment>Safe</comment>
    <icon name="multipart-encrypted"/>
    <magic priority="90">
      <match type="string" offset="0" value="🔒 [Safe] 🔒\n"/>
    </magic>
  </mime-type>
</mime-info>
