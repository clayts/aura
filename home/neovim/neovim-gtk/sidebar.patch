+// Splits the window's buttons between the header bars, as the decoration
+// layout puts them, start and end, while the sidebar is shown, or else
+// leaves them all to the editor's
+fn split_decorations(
+    window: &gtk::ApplicationWindow,
+    sidebar_header: &HeaderBar,
+    content_header: &HeaderBar,
+    sidebar_shown: bool,
+) {
+    if sidebar_shown {
+        let layout = window
+            .settings()
+            .gtk_decoration_layout()
+            .map(|layout| layout.to_string())
+            .unwrap_or_else(|| "menu:close".to_string());
+        let (start, end) = layout.split_once(':').unwrap_or((&layout, ""));
+        sidebar_header.set_decoration_layout(Some(&format!("{}:", start)));
+        content_header.set_decoration_layout(Some(&format!(":{}", end)));
+    } else {
+        content_header.set_decoration_layout(None);
+    }
+}
